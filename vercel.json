{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "rewrites": [
    { "source": "/", "destination": "/static/index.html" },
    { "source": "/rules", "destination": "/static/rules.html" },
    { "source": "/favicon.ico", "destination": "/static/favicon.svg" }
  ],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
    ]
  }]
}
