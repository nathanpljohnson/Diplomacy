# Persistent Postgres required on Vercel. Use a pooled connection URL with TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional durable phase timers, supplied by the Upstash QStash Free integration.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=
# Your public origin; callback signatures bind to this URL.
APP_URL=https://entente-diplomacy.vercel.app
